# =========================================================================
# SPICE HAVEN — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =========================================================================
# NOTE: This website runs as a zero-dependency static web application.
# Environment variables below are placeholders for production deployment,
# future backend webhooks, analytics, and third-party integrations.
# DO NOT commit real secrets or private credentials to source control.
# =========================================================================

# Production Canonical Domain
SITE_URL=https://your-restaurant-domain.com

# Concierge & Contact Details
CONTACT_EMAIL=concierge@your-restaurant-domain.com
CONTACT_PHONE=+15553827423

# Optional Analytics Tracking (e.g. Google Analytics / Plausible)
ANALYTICS_ID=G-XXXXXXXXXX

# Razorpay Payment Gateway Credentials
# Key ID (Public / Safe for frontend Razorpay Checkout initialization)
RAZORPAY_KEY_ID=rzp_test_placeholderKeyId

# Key Secret (Backend-only. Used for server-side HMAC-SHA256 signature verification)
# WARNING: NEVER expose this to client/frontend code.
RAZORPAY_KEY_SECRET=placeholderSecretKey

# Webhook Secret (Backend-only. Used for verifying incoming Razorpay webhook signatures)
# Configure this in Razorpay Dashboard > Settings > Webhooks
# WARNING: NEVER expose this to client/frontend code.
RAZORPAY_WEBHOOK_SECRET=whsec_placeholderWebhookSecret

# Server Port (Default: 3000)
PORT=3000

